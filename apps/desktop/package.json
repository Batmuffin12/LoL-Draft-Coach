{
  "name": "@ldc/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "LoL Draft Coach champ select panel (Electron, ow-electron-compatible)",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build-main.mjs && vite build",
    "start": "pnpm build && node node_modules/electron/install.js && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ldc/ddragon": "workspace:*",
    "@ldc/engine": "workspace:*",
    "@ldc/lcu": "workspace:*",
    "@ldc/riot-api": "workspace:*",
    "@ldc/shared": "workspace:*",
    "dotenv": "^18.0.5",
    "koffi": "^3.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "vite": "^8.3.2"
  }
}
