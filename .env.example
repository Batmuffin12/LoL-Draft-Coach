# Copy to .env and fill in. Never commit .env.

# --- Riot Games API ---
# Get a key at https://developer.riotgames.com
RIOT_API_KEY=
# "development" (expires every 24h) or "personal"
RIOT_KEY_TYPE=development
# Your Riot ID in quotes, e.g. "Name#TAG" (quotes are required: # starts a comment in .env)
RIOT_ID=""
# Platform and regional routing for EUW
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# --- League client ---
# Folder that contains the client's lockfile (fallback when the process can't be read)
LOL_INSTALL_DIR=C:\Riot Games\League of Legends

# --- Jev (TypeSafe AI) — TODO: no key yet, feature flag stays off ---
JEV_ENABLED=false
JEV_API_KEY=

# --- Server (apps/server; on Railway these are service variables) ---
# The server reads RIOT_API_KEY, RIOT_KEY_TYPE ("development", "personal" or "production"),
# RIOT_PLATFORM and RIOT_REGION from above.
PORT=8787
# SQLite file; on Railway point this at the mounted volume, e.g. /data/ldc.sqlite
DATABASE_PATH=data/ldc.sqlite

# --- Later milestones (not used yet) ---
# SENTRY_DSN=
# SERVER_URL=
