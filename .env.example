# Copy to .env and fill in. Never commit .env.

# --- Riot Games API ---
# Get a key at https://developer.riotgames.com
RIOT_API_KEY=
# "development" (expires every 24h) or "personal"
RIOT_KEY_TYPE=development
# Your Riot ID, e.g. Name#TAG (used when the League client is not running)
RIOT_ID=
# Platform and regional routing for EUW
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# --- League client ---
# Folder that contains the client's lockfile (fallback when the process can't be read)
LOL_INSTALL_DIR=C:\Riot Games\League of Legends

# --- Jev (TypeSafe AI) — TODO: no key yet, feature flag stays off ---
JEV_ENABLED=false
JEV_API_KEY=

# --- Later milestones (not used yet) ---
# SENTRY_DSN=
# SERVER_URL=
